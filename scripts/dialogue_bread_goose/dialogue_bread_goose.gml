function dialogue_bread_goose(){
	
return {
	
bread_goose_intro:
{
	text: "For this next test, we're going to be checking your natural survival instincts. You're going to be a slice of bread running away from ravenous geese.",
	audio: snd_bread_goose_intro
},
bread_goose_geese: 
{
	text: "Bring in the geese!",
	audio: snd_bread_goose_geese
},
bread_goose_avocado:
{
	text: "Quickly! Eat the avocados before they're no longer ripe!",
	audio: snd_bread_goose_avocado
},
bread_goose_lose:
{
	text: "Unfortunately, you were picked apart by those ravenous geese. Let's just take a moment to let that loss sink in.",
	audio: snd_bread_goose_lose
},
bread_goose_win:
{
	text: "Well done! You ate all the avocados while outrunning those ravenous geese. Let's just take a moment to enjoy the victory.",
	audio: snd_bread_goose_win
},
	
}

}